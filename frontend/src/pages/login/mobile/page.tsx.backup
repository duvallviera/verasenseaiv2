                        setError('Biometric authentication not available. Please use password login.')
                      } finally {
                        setIsLoading(false)
                      }
                    }}
                    disabled={isLoading}
                    className="w-full bg-gradient-to-r from-purple-500/20 to-pink-500/20 border border-purple-400/30 rounded-2xl p-4 flex items-center space-x-4 hover:from-purple-500/30 hover:to-pink-500/30 transition-all duration-300 disabled:opacity-50"
                  >
                    <div className="w-12 h-12 bg-gradient-to-br from-purple-500 to-pink-500 rounded-full flex items-center justify-center">
                      {isLoading ? (
                        <motion.div
                          className="w-6 h-6 border-2 border-white/30 border-t-white rounded-full"
                          animate={{ rotate: 360 }}
                          transition={{ duration: 1, repeat: Infinity, ease: "linear" }}
                        />
                      ) : (
                        <Fingerprint className="w-6 h-6 text-white" />
                      )}
                    </div>
                    <div className="flex-1 text-left">
                      <div className="text-white font-semibold">Fingerprint / Touch ID</div>
                      <div className="text-white/60 text-sm">
                        {isLoading ? 'Authenticating...' : 'Use your fingerprint to authenticate'}
                      </div>
                    </div>
                    <ArrowRight className="w-5 h-5 text-white/60" />
                  </MobileButton>
                )}
                
                {/* 📱 SMS VERIFICATION - ALWAYS VISIBLE ON MOBILE */}
