                        />
                      ) : (
                        <Camera className="w-6 h-6 text-white" />
                      )}
                    </div>
                    <div className="flex-1 text-left min-w-0">
                      <div className="text-white font-semibold text-base">Login with Biometric</div>
                      <div className="text-white/60 text-sm">
