                        style={{ WebkitTapHighlightColor: 'transparent' }}
                      >
                        {socialLoading === 'facebook' ? (
                          <div className="w-4 h-4 border-2 border-white/30 border-t-white rounded-full animate-spin"></div>
                        ) : (
                          <>
                            <div className="w-4 h-4 bg-white rounded flex items-center justify-center">
                              <span className="text-blue-600 text-xs font-bold">f</span>
              </div>
                            <span className="text-sm font-medium">Facebook</span>
                          </>
                        )}
                      </motion.button>
                      
                      <motion.button
                        whileHover={{ scale: 1.02 }}
                        whileTap={{ scale: 0.95 }}
                        onClick={() => handleSocialLogin('apple')}
                        disabled={socialLoading === 'apple'}
                        className="flex items-center justify-center space-x-2 py-4 px-3 bg-black text-white rounded-2xl hover:bg-gray-800 transition-all duration-300 disabled:opacity-50 touch-manipulation active:scale-95 min-h-[56px]"
                        style={{ WebkitTapHighlightColor: 'transparent' }}
                      >
                        {socialLoading === 'apple' ? (
                          <div className="w-4 h-4 border-2 border-white/30 border-t-white rounded-full animate-spin"></div>
                        ) : (
                          <>
                            <div className="w-4 h-4 bg-white rounded flex items-center justify-center">
                              <span className="text-black text-xs">🍎</span>
                            </div>
                            <span className="text-sm font-medium">Apple</span>
                          </>
                        )}
                      </motion.button>
                    </div>
                  </div>
                </div>

                {/* 🔐 LOGIN WITH BIOMETRIC - FROM DESKTOP */}
                <div className="mt-6">
                  <div className="relative">
                    <div className="absolute inset-0 flex items-center">
                      <div className="w-full border-t border-white/20"></div>
                    </div>
                    <div className="relative flex justify-center text-sm">
                      <span className="px-4 py-1 bg-purple-900 text-white/70 rounded-full font-medium">
                        Or login with biometric
                      </span>
                    </div>
                  </div>
                  
                  {/* 📱 BIOMETRIC LOGIN BUTTON */}
                  <div className="mt-4">
                    <motion.button
                      whileHover={{ scale: 1.02 }}
                      whileTap={{ scale: 0.95 }}
                      onClick={handleBiometricLogin}
