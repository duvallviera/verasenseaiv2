                    <Shield className="w-3 h-3 text-blue-400" />
                    <span className="text-xs text-blue-300 font-medium">Military Grade</span>
                  </div>
                  <div className="flex items-center space-x-1 bg-green-500/20 px-3 py-1 rounded-full border border-green-400/30">
                    <CheckCircle className="w-3 h-3 text-green-400" />
                    <span className="text-xs text-green-300 font-medium">Secure</span>
                  </div>
                  <div className="flex items-center space-x-1 bg-purple-500/20 px-3 py-1 rounded-full border border-purple-400/30">
                    <Mail className="w-3 h-3 text-purple-400" />
                    <span className="text-xs text-purple-300 font-medium">Email Verified</span>
                  </div>
                </div>
              </div>
              
              {/* 🌐 "OR CONTINUE WITH" DIVIDER (from desktop) */}
              <div className="relative">
                <div className="absolute inset-0 flex items-center">
                  <div className="w-full border-t border-white/20"></div>
