                  <span className="px-4 py-1 bg-purple-900 text-white/70 rounded-full font-medium">
                    Or continue with
                  </span>
                </div>
              </div>
              
              {/* 📱 MOBILE AUTHENTICATION OPTIONS CONTAINER */}
              <MobileButtonContainer forceVisible={true} className="mobile-button-container space-y-4 px-2">
                {/* 📱 DEBUG: Log button visibility */}
                {(() => {
                  console.log('🔍 Mobile Button Visibility Check:', {
                    biometricSupport,
                    mobileDeviceInfo,
                    isMobile: mobileDeviceInfo.isMobile,
                    faceId: biometricSupport.faceId,
                    fingerprint: biometricSupport.fingerprint,
                    showFaceId: (biometricSupport.faceId || mobileDeviceInfo.isMobile),
                    showFingerprint: (biometricSupport.fingerprint || mobileDeviceInfo.isMobile)
                  })
                  return null
                })()}
                
                {/* 📱 ALWAYS SHOW BIOMETRIC OPTIONS ON MOBILE */}
                {(biometricSupport.faceId || mobileDeviceInfo.isMobile) && (
                  <MobileButton
                    forceVisible={true}
                    onClick={async () => {
                      setIsLoading(true)
                      setError(null)
                      try {
                        console.log('📸 Face Recognition button clicked')
                        const result = await performFaceRecognition()
                        setBiometricResult(result)
                        if (result.success) {
                          console.log('✅ Face recognition successful, moving to email step')
                          setStep('email')
                        } else {
                          setError('Face recognition failed. Please try again or use password login.')
                        }
                      } catch (err: any) {
                        console.error('❌ Face recognition error:', err)
                        setError(err.message || 'Camera access denied. Please enable camera permissions or use password login.')
                      } finally {
                        setIsLoading(false)
                      }
                    }}
                    disabled={isLoading}
                    className="w-full bg-gradient-to-r from-blue-500/20 to-cyan-500/20 border border-blue-400/30 rounded-2xl p-4 flex items-center space-x-4 hover:from-blue-500/30 hover:to-cyan-500/30 transition-all duration-300 disabled:opacity-50 touch-manipulation active:scale-95 select-none"
                    style={{ 
